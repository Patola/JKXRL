# Maintainer: Cláudio "Patola" Sampaio <patola at gmail dot com>
#
# JKXRL native Linux PCVR build, based on JKXR (Team Beef's VR port of Jedi Academy /
# Jedi Outcast), using SDL3 and the OpenXR Vulkan graphics binding.
#
# Game data is NOT included. You need your own copy of the games (Steam/GOG);
# see the post-install notes / BUILDING_LINUX.md.
#
# Stable release; source is pinned to the matching public tag.

pkgname=jkxrl
pkgver=0.6
pkgrel=1
pkgdesc="JKXRL - Jedi Academy and Jedi Outcast in native Linux VR (Vulkan, SDL3, OpenXR)"
arch=('x86_64')
url="https://github.com/Patola/JKXRL"
license=('GPL-2.0-only')
depends=('sdl3' 'openxr' 'vulkan-icd-loader' 'zlib' 'libpng' 'libjpeg-turbo')
makedepends=('git' 'cmake' 'zip' 'vulkan-headers' 'shaderc' 'glslang')
conflicts=('jkxrl-git')
install=jkxr.install
# This old Quake-derived codebase relies on -fno-strict-aliasing and modest
# optimisation (see BUILDING_LINUX.md); LTO across modules is asking for it.
options=('!lto')
source=("JKXRL::git+https://github.com/Patola/JKXRL.git#tag=v${pkgver}")
sha256sums=('SKIP')

build() {
	cmake -S JKXRL/OpenJK -B build \
		-DCMAKE_BUILD_TYPE=Release \
		-DBuildMPEngine=OFF -DBuildMPRdVanilla=OFF -DBuildMPDed=OFF \
		-DBuildMPGame=OFF -DBuildMPCGame=OFF -DBuildMPUI=OFF \
		-DBuildSPEngine=ON -DBuildSPGame=ON -DBuildSPRdVanilla=OFF -DBuildSPRdVulkan=ON \
		-DBuildJK2SPEngine=ON -DBuildJK2SPGame=ON -DBuildJK2SPRdVanilla=OFF -DBuildJK2SPRdVulkan=ON \
		-DBuildTests=OFF
	cmake --build build

	# Pack the VR asset pk3s
	(cd JKXRL && ./make_z_vr_assets_pk3.sh)
}

package() {
	# Engines and renderers live together beside the executable.
	install -Dm755 -t "$pkgdir/usr/lib/jkxr" \
		build/openjk_sp.x86_64 \
		build/openjo_sp.x86_64 \
		build/code/rd-vulkan/rdsp-vulkan_x86_64.so \
		build/code/rd-vulkan/rdjosp-vulkan_x86_64.so

	# Game modules belong in the base search directory. This is checked before
	# GameData-root modules left by older manual installations.
	install -Dm755 -t "$pkgdir/usr/lib/jkxr/base" \
		build/code/game/jagamex86_64.so \
		build/codeJK2/game/jospgamex86_64.so

	# VR asset pk3s; the launchers sync these into the engine's per-user
	# home path (~/.local/share/openjk|openjo/base) on start.
	install -Dm644 -t "$pkgdir/usr/share/jkxr/jka" \
		JKXRL/assets/z_vr_assets_base.pk3 \
		JKXRL/assets/z_vr_assets_jka.pk3 \
		"JKXRL/assets/weapons/z_vr_weapons_jka_Crusty_and_Elin.pk3"
	install -Dm644 -t "$pkgdir/usr/share/jkxr/jko" \
		JKXRL/assets/z_vr_assets_base.pk3 \
		JKXRL/assets/z_vr_assets_jko.pk3 \
		"JKXRL/assets/weapons/z_vr_weapons_jko_Crusty_and_Elin.pk3"

	# Launchers
	install -Dm755 -t "$pkgdir/usr/bin" \
		JKXRL/packaging/arch/jkxr-jka \
		JKXRL/packaging/arch/jkxr-jko

	install -Dm644 JKXRL/BUILDING_LINUX.md -t "$pkgdir/usr/share/doc/jkxr"
	install -Dm644 JKXRL/README.md JKXRL/ROADMAP.md JKXRL/RELEASE_NOTES.md \
		JKXRL/assets/packaged_mods_credits.txt -t "$pkgdir/usr/share/doc/jkxr"
	install -Dm644 JKXRL/OpenJK/docs/console-variables.md -t "$pkgdir/usr/share/doc/jkxr"
	cp -r JKXRL/OpenJK/docs/cvars "$pkgdir/usr/share/doc/jkxr/"
	install -Dm644 JKXRL/LICENSE.txt "$pkgdir/usr/share/licenses/$pkgname/LICENSE.txt"
}
